{
  "name": "maoxuan-app",
  "productName": "毛选实用工具箱",
  "version": "0.4.0",
  "description": "带着问题读《毛选》：明确问题、聚焦核心、联系自身、反复应用",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "extract": "python3 scripts/extract_epub.py",
    "codegen": "node scripts/ds-codegen.mjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "test": "node scripts/run-tests.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:proxy": "npm run build && node scripts/smoke-proxy.mjs",
    "test:smoke": "npm run build && node scripts/smoke-multibook.mjs",
    "verify": "npm run check:boundaries && npm test && npm run typecheck && npm run build",
    "audio:generate": "node scripts/generate-core-audio.mjs",
    "audio:check": "node scripts/check-core-audio.mjs"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.0.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "iconv-lite": "^0.7.3",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.liamreed.maoxuan",
    "productName": "毛选实用工具箱",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/articles.json",
        "to": "articles.json"
      },
      {
        "from": "resources/core-audio/v1",
        "to": "core-audio/v1",
        "filter": [
          "*.audio",
          "manifest.json"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "maoxuan-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "beforePack": "scripts/before-pack.cjs"
  }
}
